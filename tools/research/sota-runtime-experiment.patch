+static uint32_t RegQueryValueExA(const uint32_t *a)
+{
+    const char *v = !strcmp(P(a[1]), "FirstInstallDateTime") ? "\x78\x56\x34\x12" : !strcmp(P(a[1]), "ProductId") ? "12345-OEM-0012345-12345" : NULL;
+    size_t n;
 
+    if (!v)
+        return 2;
+    n = !strcmp(P(a[1]), "ProductId") ? strlen(v) + 1 : 4;
+    if (a[4] && a[5] && RD32(a[5]) >= n)
+        memcpy(P(a[4]), v, n);
+    if (a[5])
+        WR32(a[5], (uint32_t)n);
+    if (a[3])
