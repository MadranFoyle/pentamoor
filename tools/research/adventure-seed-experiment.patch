 }
-static uint32_t crt_srand(const uint32_t *a) { rand_seed = a[0]; return 0; }
+static uint32_t res_seedhook(const uint32_t *a)
+{
+    (void)a;
+    rand_seed = (uint32_t)strtoul(getenv("RES_SEED"), NULL, 0);
+    fprintf(stderr, "RES seed hook: rand_seed reset after %lu rand calls\n", rand_calls);
+    return 0;
+}
+static uint32_t crt_srand(const uint32_t *a)
+{
+    const char *h = getenv("RES_HOOKADDR");
+    if (h && getenv("RES_SEED") && !port_prehook_fn((uint32_t)strtoul(h, NULL, 0)))
+        port_prehook((uint32_t)strtoul(h, NULL, 0), res_seedhook);
+    const char *f = getenv("RES_SEED");
+    fprintf(stderr, "RES srand(%u) after %lu rand calls%s\n", a[0], rand_calls, f ? " (forced)" : "");
+    rand_seed = f ? (uint32_t)strtoul(f, NULL, 0) : a[0];
+    return 0;
+}
 static uint32_t crt_clock(const uint32_t *a)
 {
     (void)a;
-    return (uint32_t)(port_now() * 1000.0);        /* milliseconds since the program started, by the wall clock (the host's clock() counts CPU time) */
+    {
+        uint32_t v = (uint32_t)(port_now() * 1000.0);
+        const char *c7 = getenv("RES_CLOCK7");
+        if (c7)
+            v = (v & ~0x7fu) | ((uint32_t)strtoul(c7, NULL, 0) & 0x7fu);
+        return v;
+    }
 }
 static uint32_t crt_time(const uint32_t *a)
 {
     uint32_t t = (uint32_t)time(NULL);
