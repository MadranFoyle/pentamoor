[Desktop Entry]
Type=Application
Version=1.0
Name=Install Spells of the Ancients
GenericName=Magic: The Gathering, Spells of the Ancients 2.15
Comment=Add the Spells of the Ancients expansion (version 2.15) to Pentamoor, from your own disc image and the 2.15 patch
Exec=sh -c 'exec "$(dirname "${1#file://}")/tools/steamdeck/install-gui.sh" --sota' sh %k
Icon=applications-games
Terminal=false
Categories=Game;
StartupNotify=true
